{
    "name": "wp-phpunit/wp-phpunit",
    "description": "WordPress core PHPUnit library",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Evan Mattson",
            "email": "me@aaemnnost.tv"
        },
        {
            "name": "WordPress Community",
            "homepage": "https://wordpress.org/about/"
        }
    ],
    "keywords": [
        "wordpress",
        "phpunit",
        "test"
    ],
    "homepage": "https://github.com/kolotov/wp-phpunit",
    "support": {
        "source": "https://github.com/kolotov/wp-phpunit",
        "issues": "https://github.com/kolotov/wp-phpunit/issues",
        "docs": "https://github.com/kolotov/wp-phpunit#readme"
    },
    "require": {
        "php": "~8.5.0",
        "phpunit/phpunit": "^13.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.6",
        "phpcompatibility/php-compatibility": "^10.0@alpha",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.1",
        "friendsofphp/php-cs-fixer": "^3.89",
        "brianium/paratest": "^7.24"
    },
    "autoload": {
        "files": ["__loaded.php"]
    },
    "scripts": {
        "test": [
            "@php tools/require-container-or-ci.php",
            "phpunit"
        ],
        "analyse": [
            "@php tools/require-container-or-ci.php",
            "phpstan analyse"
        ],
        "compatibility": [
            "@php tools/require-container-or-ci.php",
            "phpcs --standard=phpcs.xml.dist"
        ],
        "format": [
            "@php tools/require-container-or-ci.php",
            "php-cs-fixer fix --config=.php-cs-fixer.php"
        ],
        "format:check": [
            "@php tools/require-container-or-ci.php",
            "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff"
        ],
        "rector:check": [
            "@php tools/require-container-or-ci.php",
            "rector process --dry-run"
        ],
        "rector:fix": [
            "@php tools/require-container-or-ci.php",
            "rector process"
        ],
        "quality": [
            "@php tools/require-container-or-ci.php",
            "@test",
            "@compatibility",
            "@format:check",
            "@rector:check"
        ]
    },
    "config": {
        "process-timeout": 0,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
